{
  "manifest_version": 3,
  "name": "Screenwatch seat helper",
  "version": "1.2.0",
  "description": "Opens a Screenwatch seat alert in Chrome and prepares BookMyShow checkout after your confirmation.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "notifications", "tabs", "tts"],
  "host_permissions": [
    "https://bmschatgptbot-production.up.railway.app/*",
    "https://in.bookmyshow.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Screenwatch seat helper", "default_popup": "popup.html" },
  "icons": { "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://in.bookmyshow.com/movies/*/seat-layout/*"],
      "js": ["seatlogic.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://in.bookmyshow.com/movies/*/seat-layout/*"],
      "js": ["seatlogic.js", "page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
